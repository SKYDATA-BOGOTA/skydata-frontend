{
  "name": "skydata-frontend",
  "version": "1.0.0",
  "description": "Frontend del sistema SKYDATA Bogotá",
  "main": "js/main.js",
  "scripts": {
    "dev": "live-server --port=8080",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:acceptance": "jest tests/acceptance/",
    "test:security": "jest tests/security/",
    "test:performance": "jest tests/performance/",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "security:audit": "npm audit",
    "quality:check": "npm run lint && npm run security:audit && npm run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "skydata",
    "bogota",
    "environmental",
    "geojson"
  ],
  "author": "SKYDATA Bogotá",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@playwright/test": "^1.45.3",
    "@testing-library/jest-dom": "^6.9.1",
    "babel-jest": "^30.2.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^23.2.0",
    "live-server": "^1.2.2",
    "msw": "^2.12.3",
    "whatwg-fetch": "^3.6.20"
  },
  "dependencies": {}
}
