{
  "name": "skydata-frontend",
  "version": "1.0.0",
  "description": "Frontend del proyecto SKYDATA - Interfaz de visualización de datos de estaciones de monitoreo ambiental de Bogotá",
  "main": "src/index.js",
  "scripts": {
    "start": "http-server public -p 8080",
    "dev": "http-server public -p 8080 -c-1",
    "build": "echo 'Build completed'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":60,\"functions\":60,\"lines\":60,\"statements\":60}}'",
    "test:unit": "jest tests/*.test.js",
    "test:integration": "jest tests/integration/",
    "test:acceptance": "jest tests/acceptance/",
    "test:security": "jest tests/security/",
    "test:performance": "jest tests/performance/",
    "test:compatibility": "jest tests/compatibility/",
    "test:usability": "jest tests/usability/",
    "test:reliability": "jest tests/reliability/",
    "test:quality-in-use": "jest tests/quality-in-use/",
    "test:e2e": "playwright test tests/e2e/",
    "lint": "eslint . --ext .js || echo 'Linting completed with warnings'",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "keywords": [
    "skydata",
    "leaflet",
    "geojson",
    "monitoreo",
    "bogota",
    "mapa",
    "iso-25000"
  ],
  "author": "SKYDATA-BOGOTA",
  "license": "MIT",
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.50.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "public/js/**/*.js",
      "!**/*.test.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "verbose": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
