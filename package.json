{
  "name": "skydata-frontend",
  "version": "1.0.0",
  "description": "Frontend del proyecto SKYDATA - Interfaz de visualización de datos de estaciones de monitoreo ambiental de Bogotá",
  "main": "src/index.js",
  "scripts": {
    "start": "http-server -p 8080",
    "dev": "http-server -p 8080 -c-1",
    "build": "echo 'Build completed'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/*.test.js --passWithNoTests",
    "test:integration": "jest --testPathPattern=tests/integration --passWithNoTests",
    "test:acceptance": "jest --testPathPattern=tests/acceptance --passWithNoTests",
    "test:security": "jest --testPathPattern=tests/security --passWithNoTests",
    "test:performance": "jest --testPathPattern=tests/performance --passWithNoTests",
    "test:compatibility": "jest --testPathPattern=tests/compatibility --passWithNoTests",
    "test:usability": "jest --testPathPattern=tests/usability --passWithNoTests",
    "test:reliability": "jest --testPathPattern=tests/reliability --passWithNoTests",
    "test:quality-in-use": "jest --testPathPattern=tests/quality-in-use --passWithNoTests",
    "test:e2e": "echo 'E2E tests require Playwright installed'",
    "lint": "eslint . --ext .js || true"
  },
  "keywords": [
    "skydata",
    "leaflet",
    "geojson",
    "monitoreo",
    "bogota",
    "iso-25000"
  ],
  "author": "SKYDATA-BOGOTA",
  "license": "MIT",
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
